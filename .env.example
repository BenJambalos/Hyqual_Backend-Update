# Copy this file to .env and fill in real values before running the server.

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=hyquai_app
DB_PASSWORD=hyquai_dev_pw
DB_NAME=hyquai_db

# --- Auth ---
# Generate a real random string for production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# --- Server ---
PORT=4000

# --- Railway (production) ---
# On Railway you don't need DB_* at all: the backend falls back to the
# MYSQLHOST / MYSQLPORT / MYSQLUSER / MYSQLPASSWORD / MYSQLDATABASE
# variables that Railway's MySQL service exposes. Link them to this
# service (Variables > Add Reference) and also set:
#   JWT_SECRET=<long random string>
#   NODE_ENV=production
# Railway sets PORT itself. Set the service's Root Directory to
# hyquai_backend if your repo also contains the Flutter app.
